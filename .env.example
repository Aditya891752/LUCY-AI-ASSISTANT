# =============================================================================
# LUCY AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. NEVER COMMIT .env.local!
# =============================================================================

# Public Client Configuration (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
VAPID_PUBLIC_KEY=your-vapid-public-key

# Server-Only Private Credentials (CRITICAL: NEVER PREFIX WITH NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
VAPID_PRIVATE_KEY=your-vapid-private-key
